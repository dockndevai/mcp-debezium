{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.dockndevai/mcp-debezium",
  "description": "Debezium / Kafka Connect CDC connector management for AI agents — governed, secret-safe.",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/dockndevai/mcp-debezium",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@dockndevai/mcp-debezium",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "CONNECT_URL",
          "description": "Base URL of the Kafka Connect REST API.",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "DEBEZIUM_MODE",
          "description": "Access mode: read-only | read-write | admin.",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
