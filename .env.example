# --- Connection -------------------------------------------------------------
# Base URL of the Kafka Connect REST API that Debezium runs on.
CONNECT_URL=http://localhost:8083
# Optional HTTP basic auth for the Connect REST API.
# CONNECT_USERNAME=
# CONNECT_PASSWORD=
CONNECT_TIMEOUT_MS=15000

# --- Security flags ---------------------------------------------------------
# Access mode: read-only | read-write | admin. Start with read-only.
DEBEZIUM_MODE=read-only
# Comma-separated connector allowlist. Empty = all connectors.
DEBEZIUM_CONNECTOR_ALLOWLIST=
# Connectors that can be read but never mutated/deleted.
DEBEZIUM_PROTECTED_CONNECTORS=
# delete_connector requires this in addition to admin mode.
DEBEZIUM_ALLOW_DELETE=false
# Validate + log writes without sending them to Kafka Connect.
DEBEZIUM_DRY_RUN=false
# Emit a JSON audit line to stderr per guarded operation.
DEBEZIUM_AUDIT_LOG=true

# --- AI risk guard (optional; needs a running laya-guard daemon) -------------
# High-risk ops ask a LOCAL laya-guard daemon to classify them allow / confirm / block. Runs AFTER
# the deterministic gates; only tightens, never grants; fails closed.  off | monitor | enforce
DEBEZIUM_GUARD_MODE=off
DEBEZIUM_GUARD_URL=http://127.0.0.1:8799
DEBEZIUM_GUARD_TIMEOUT_MS=2000
DEBEZIUM_GUARD_FAIL_CLOSED=confirm
